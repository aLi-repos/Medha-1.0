# Local development configuration only. Do not add secrets to this file.
MEDHA_APP_NAME=MEDHA Backend
MEDHA_APP_VERSION=0.1.0
MEDHA_ENV=development
# Generate a unique value locally; never commit a real secret.
MEDHA_JWT_SECRET=replace-with-a-long-random-local-development-secret
MEDHA_JWT_EXPIRATION_MINUTES=30
# Database URL — SQLite for development, PostgreSQL for production.
MEDHA_DATABASE_URL=sqlite:///medha.db
# Local Ollama-compatible inference runtime (no cloud fallback).
MEDHA_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
MEDHA_LOCAL_LLM_MODEL=qwen2.5:3b-instruct
